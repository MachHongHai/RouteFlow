FROM app
USER root
COPY routeflow/console.py routeflow/console_broker.py routeflow/console_entry.py routeflow/console_storage.py /app/routeflow/
COPY routeflow/console_assets /app/routeflow/console_assets
COPY routeflow/console_generation.py routeflow/generation_context.py routeflow/domain.py /app/routeflow/
COPY routeflow/console_database.py /app/routeflow/
RUN mkdir -p /var/lib/routeflow-console && chown 10001:10001 /var/lib/routeflow-console
ENV ROUTEFLOW_CONSOLE_CONTAINER=1 PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "-m", "routeflow.console_entry"]
